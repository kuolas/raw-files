#!/bin/sh
# commit-msg — check a commit message against CONTRIBUTING.md §Commit messages.
# CI runs this same file over every commit of a pull request, with
# COMMIT_MSG_STORED=1; scripts/test-hooks.sh tests it.
#
# The grammar is GNOME's: `component: Summary` — at most one tag, a capitalised
# summary, no trailing period, a blank second line, a ~72-char subject and
# 75-char body lines (notes, not refusals), no tool attribution, and strict
# issue references for Closes:/Fixes:/Issue: (other trailers only warn).
#
# Bypass once:  SKIP_HOOKS=1 git commit …
set -eu

# Read the message as bytes, whatever your locale: in a Turkish one,
# `grep -i` does not fold I and i, and a range such as `[a-z]` can hold
# other letters, so every check would answer differently there. Lengths
# then count bytes, so a line with accented letters gets the 75-column
# note a little early; it is only a note.
LC_ALL=C
export LC_ALL

if [ -n "${SKIP_HOOKS:-}" ]; then
	echo "commit-msg: skipped (SKIP_HOOKS set)"
	exit 0
fi

msg_file="$1"

# Every check below judges the message as git will store it, not the raw
# file: git runs this hook before it cleans the message up. So, as
# `git commit --cleanup=strip` would: everything from the scissors line down
# is cut off (`git commit -v` appends the diff below it, and a diff is not a
# body: its long lines, its quoted trailers), comment lines are dropped,
# trailing whitespace is stripped from every line, and leading blank lines
# go (trailing ones go with `$(…)`). Otherwise a trailing space hides the
# subject's period, and a leading blank or comment line leaves an empty
# subject that skips every check.
#
# A stored message (COMMIT_MSG_STORED, set by CI) keeps its `#` and scissors
# lines: `git commit -m` and `-F` clean up whitespace only, so `#12 Fix the
# crash` can be a stored subject, and dropping it would judge the wrong line,
# or none. At commit time the hook cannot tell `-m` from the editor, and
# drops them as the editor does; so a `-m` subject starting with `#` is
# refused or judged by the line after it. Write `Issue #12` instead, or put
# a component tag first.
uncommented() {
	if [ -n "${COMMIT_MSG_STORED:-}" ]; then
		cat "$msg_file"
	else
		sed '/^# -\{24\} >8 -\{24\}$/,$d' "$msg_file" | grep -v '^#' || true
	fi
}
message="$(uncommented | sed 's/[[:space:]]*$//' | awk 'NF || seen { seen = 1; print }')"
subject="$(printf '%s\n' "$message" | head -n 1)"

fail() {
	printf 'commit-msg: %s\n\n  %s\n\nSee CONTRIBUTING.md §Commit messages. Bypass once: SKIP_HOOKS=1 git commit\n' \
		"$1" "$subject" >&2
	exit 1
}

# An empty message: git aborts the commit itself, so there is nothing to judge.
[ -n "$message" ] || exit 0

# A commit is authored by whoever committed it. No assistant/model/tool
# attribution, in any casing, in a trailer or a footer. This holds
# for every message, git's own subjects below included: only the grammar is
# waived for them. `git revert` commits without running this hook, so for a
# revert it is CI, running this file over the stored message, that applies it.
#
# A person may be a co-author, so a line is refused only where it names a
# tool. Both rules read lines that start with `Co-authored-by:` or
# `Generated with`, as a trailer or footer does, and match a tool's name as
# a whole word (no letter or digit on either side), so `egptech.org` passes.
#
# A `Co-authored-by:` line is a tool's when:
#   - its login ends in `[bot]`, which is never a person: GitHub writes
#     `claude[bot]`, `copilot-swe-agent[bot]`, `google-labs-jules[bot]`;
#   - its name, before the `<`, is a tool's. Claude and Devin are also
#     people's first names, so they count only as the tools write them
#     (`Claude Code`, `Claude Opus 4`, `Devin AI`);
#   - its address is one a tool writes, such as `noreply@anthropic.com`.
#     A whole domain is not enough: the people who make a tool have
#     addresses there too, and may be co-authors.
# A `Generated with` line is a tool's when a tool is named anywhere after
# those words (`Generated with the help of Claude Code`). `Cursor` counts
# only with its capital, since a byte parser's prose says "generated with
# cursor reads".
word_start='(^|[^[:alnum:]])'
word_end='([^[:alnum:]]|$)'
tool='(anthropic|openai|chatgpt|gpt(-?[0-9][0-9a-z.]*)?|copilot|gemini|codeium|codex|aider|opencode|codebuff)'
tool_name="(${tool}|cursor|claude[- ](code|opus|sonnet|haiku|fable|ai|[0-9])|devin[- ]ai)"
tool_mail='<(noreply@anthropic\.com|cursoragent@cursor\.com|aider@aider\.chat|amp@ampcode\.com|noreply@opencode\.ai|noreply@codebuff\.com)>'
coauthors="$(printf '%s\n' "$message" | grep -iE '^co-authored-by:' || true)"
coauthor_names="$(printf '%s\n' "$coauthors" | sed 's/^[^:]*://; s/<.*//')"
if printf '%s\n' "$coauthors" | grep -qF '[bot]' ||
	printf '%s\n' "$coauthor_names" | grep -qiE "${word_start}${tool_name}${word_end}" ||
	printf '%s\n' "$coauthors" | grep -qiE "$tool_mail"; then
	fail 'tool named as co-author — a tool is not an author; disclose AI help with an Assisted-by: trailer'
fi
generated="$(printf '%s\n' "$message" | grep -iE '^[^[:alnum:]]*generated with ' || true)"
if printf '%s\n' "$generated" | grep -qiE "${word_start}(${tool}|claude|devin)${word_end}" ||
	printf '%s\n' "$generated" | grep -qE "${word_start}Cursor${word_end}"; then
	fail '"Generated with" footer naming a tool — a tool is not an author; disclose AI help with an Assisted-by: trailer'
fi

# Git's own subjects skip the grammar and trailer checks below, in the shapes
# git (and GitHub's merge button) write them, never any subject that merely
# starts with the word: "Revert stuff" or "Merge everything" is a person's
# subject and is judged. Git writes `Reapply "…"` when it reverts a revert.
case "$subject" in
	"Merge branch '"* | "Merge branches '"* | \
		"Merge remote-tracking branch '"* | "Merge remote-tracking branches '"* | \
		"Merge tag '"* | "Merge tags '"* | "Merge commit '"* | "Merge commits '"* | \
		"Merge pull request #"* | \
		'Revert "'* | 'Reapply "'* | "fixup! "* | "squash! "* | "amend! "*)
		exit 0
		;;
esac

# Issue reference, as GitHub resolves it: #N, owner/repo#N, or a full URL.
issue_ref='(#[0-9]+|[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+|https://[^[:space:]]+)'

# A first word ending in ':' is a component tag. It must be one word —
# `fix(ui):` is a Conventional Commits subject, the commonest way to
# get this wrong.
first="${subject%% *}"
summary="$subject"
case "$first" in
*:)
	if ! printf '%s' "${first%:}" | grep -qE '^[A-Za-z0-9][A-Za-z0-9_.+/-]*$'; then
		fail "component tag '${first%:}' is not one word (letters, digits, _ . + / -) — the grammar is 'component: Summary'"
	fi
	summary="${subject#* }"
	[ "$summary" != "$subject" ] || fail 'nothing after the component tag'
	;;
esac
# A tag glued to its summary (`ui:fix the thing`, `fix(ui):thing`) does not
# end in ':', so the case above misses it: a lower-case word, perhaps with a
# part in parentheses, one colon, then a letter. Tags are lower-case words;
# a capitalised one is a name such as Exif's `EXIF:Orientation`. Anything
# else around the colon is no tag either: `Vec::new`, a backticked word, a
# URL, a time or ratio (`10:30`, `16:9`), a drive (`C:\Users`), a file and
# line (`src/lib.rs:42`). A tab is no separator: the words here are split
# at spaces, so a tab would hide a tag and its summary.
tab="$(printf '\t')"
case "$subject" in
*"$tab"*) fail 'the subject holds a tab — separate words with spaces' ;;
esac
if printf '%s' "$first" | grep -qE '^[a-z][a-z0-9_.+/-]*(\([^)]*\))?:[A-Za-z]' ||
	! printf '%s' "$summary" | grep -qE '^[^[:space:]]'; then
	fail 'one space after the component tag, then the summary'
fi
word="${summary%% *}"
case "$word" in
*:) fail 'one component tag at most (GNOME: "prefix the first line with one tag")' ;;
esac
# A plain lower-case word ("fix", "add") is refused, an apostrophe (straight
# or typographic) or one trailing punctuation mark included ("don't",
# "don’t", "add,", "fix."). GNOME
# capitalises the summary; an identifier keeps its case, and is told apart
# by what makes it code — `_`, `()`, `::`, a digit, a capital, backticks,
# or a hyphen (a crate name such as `raw-files`).
if printf '%s' "$word" | grep -qE "^[a-z][a-z'’]*[,;.!?]?\$"; then
	fail "summary starts with the lower-case word '$word' — GNOME capitalises it ('sound: Fix label alignments'); write an identifier as it appears in code, or in backticks"
fi

if printf '%s' "$subject" | grep -qE '\.$'; then
	fail 'subject ends with a period'
fi

if [ -n "$(printf '%s\n' "$message" | sed -n 2p)" ]; then
	fail 'the second line must be blank — subject, blank line, then the body'
fi

len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
	echo "commit-msg: note — subject is ${len} chars (guideline is ~72)" >&2
fi

# GNOME: "Each line must not exceed 75 characters." A note, not a refusal:
# a pasted log line or a long identifier is a legitimate exception, and a
# hook that refuses those gets bypassed. Lines without a space (a URL, a
# path) cannot be wrapped and are left alone.
long=$(printf '%s\n' "$message" | awk 'NR > 1 && length($0) > 75 && / / { n++ } END { print n + 0 }')
if [ "$long" -gt 0 ]; then
	echo "commit-msg: note — ${long} body line(s) over 75 chars (GNOME wraps the body at 75)" >&2
fi

# Trailer checks read the TRAILER BLOCK (the final paragraph), never the whole
# body: a wrapped sentence can easily start a line with "Fixes:", and a hard
# check that fires on prose is a hook people learn to bypass. git's own parser
# draws that line for us.
trailers="$(printf '%s\n' "$message" | git interpret-trailers --parse --no-divider 2>/dev/null || true)"

malformed() {
	printf 'commit-msg: malformed trailer — %s\n\ngot:\n\n%s\n' "$1" "$2" >&2
	exit 1
}

# Closes:/Fixes: close the issue when the commit reaches master; Issue: only
# references it (a series of commits toward one issue, none of which
# closes it). All three take an issue reference, checked strictly: a
# reference nothing can resolve reads as an answer while linking nothing.
# Keys in any casing: GitHub reads `closes: #12` as `Closes: #12`.
bad="$(printf '%s\n' "$trailers" | grep -iE '^(Closes|Fixes|Issue):' |
	grep -viE "^(Closes|Fixes|Issue): $issue_ref\$" || true)"
[ -z "$bad" ] || malformed 'Closes:, Fixes: and Issue: take an issue reference:

  Closes: #12
  Fixes: owner/repo#12
  Issue: https://github.com/owner/repo/issues/12

(The kernel-style "Fixes: <hash> (\"subject\")" is not used here; name the
commit that introduced a bug in the body.)' "$bad"
sanctioned='Closes|Fixes|Issue|Assisted-by'
house='Closes:, Fixes:, Issue:, Assisted-by:'

# Anything else in the trailer block: warn, never block. A genuinely new trailer
# is a CONTRIBUTING change rather than a typo, and the cost of a false positive
# here is a bypassed hook — worse than the typo it would have caught. Keys
# in any casing here too, so `reviewed-by:` is noted and `assisted-by:` is
# not.
unsanctioned="$(printf '%s\n' "$trailers" \
	| grep -E '^[A-Za-z][A-Za-z-]+(-[A-Za-z]+)*: ' \
	| grep -viE "^($sanctioned): " || true)"
if [ -n "$unsanctioned" ]; then
	printf 'commit-msg: note — unsanctioned trailer(s) (house set: %s):\n%s\n' \
		"$house" "$unsanctioned" >&2
fi

exit 0
